#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(set = 0, binding = 0, rgba16f) writeonly uniform image3D uNoiseVolume;
layout(set = 0, binding = 1, std140) uniform NoiseSettings
{
    uint seed;
    float frequency;
    float detailFrequency;
    float padding;
} settings;

float Hash31(vec3 p)
{
    p = fract(p * 0.1031);
    p += dot(p, p.yxz + 33.33 + float(settings.seed) * 0.0001);
    return fract((p.x + p.y) * p.z);
}

float ValueNoise(vec3 p)
{
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = Hash31(i + vec3(0, 0, 0));
    float n100 = Hash31(i + vec3(1, 0, 0));
    float n010 = Hash31(i + vec3(0, 1, 0));
    float n110 = Hash31(i + vec3(1, 1, 0));
    float n001 = Hash31(i + vec3(0, 0, 1));
    float n101 = Hash31(i + vec3(1, 0, 1));
    float n011 = Hash31(i + vec3(0, 1, 1));
    float n111 = Hash31(i + vec3(1, 1, 1));

    float x00 = mix(n000, n100, f.x);
    float x10 = mix(n010, n110, f.x);
    float x01 = mix(n001, n101, f.x);
    float x11 = mix(n011, n111, f.x);
    return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
}

float WorleyNoise(vec3 p)
{
    vec3 cell = floor(p);
    vec3 local = fract(p);
    float nearest = 1.0;

    for (int z = -1; z <= 1; ++z)
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        vec3 neighbour = vec3(x, y, z);
        vec3 randomPoint = vec3(
            Hash31(cell + neighbour + vec3(17.1, 3.7, 11.2)),
            Hash31(cell + neighbour + vec3(5.3, 19.7, 2.1)),
            Hash31(cell + neighbour + vec3(9.2, 7.4, 23.6))
        );
        vec3 delta = neighbour + randomPoint - local;
        nearest = min(nearest, length(delta));
    }

    return clamp(nearest / 1.7320508, 0.0, 1.0);
}

float FBM(vec3 p)
{
    float value = 0.0;
    float amplitude = 0.5;
    float total = 0.0;
    for (int i = 0; i < 4; ++i)
    {
        value += ValueNoise(p) * amplitude;
        total += amplitude;
        p *= 2.03;
        amplitude *= 0.5;
    }
    return value / max(total, 1e-5);
}

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(uNoiseVolume);
    if (any(greaterThanEqual(id, size)))
        return;

    vec3 uvw = (vec3(id) + 0.5) / vec3(size);
    vec3 p = uvw * max(settings.frequency, 1.0);

    float perlin = FBM(p);
    float worley = WorleyNoise(p * 2.0);
    float detail = WorleyNoise(uvw * max(settings.detailFrequency, 1.0));

    // Channels are intentionally packed for cloud shaders:
    // R = broad Perlin structure, G = Worley cell distance, B = detail erosion noise.
    imageStore(uNoiseVolume, id, vec4(perlin, worley, detail, 1.0));
}
