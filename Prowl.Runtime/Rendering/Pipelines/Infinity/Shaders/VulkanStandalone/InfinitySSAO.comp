#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D deviceDepthTexture;
layout(set = 0, binding = 1) uniform sampler2D viewNormalTexture;
layout(set = 0, binding = 2) uniform sampler2D blueNoiseTexture;
layout(set = 0, binding = 3, r16f) uniform writeonly image2D aoOutput;
layout(set = 0, binding = 4, std140) uniform SSAOSettings
{
    mat4 inverseProjection;
    vec4 radiusBiasIntensity; // radius, bias, intensity, power
    ivec4 screenAndQuality; // width, height, directions, steps per direction
} settings;

vec3 ReconstructViewPosition(vec2 uv, float depth)
{
    vec4 p = settings.inverseProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return p.xyz / max(abs(p.w), 1e-6);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(aoOutput);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float centerDepth = texture(deviceDepthTexture, uv).r;
    if (centerDepth <= 0.0)
    {
        imageStore(aoOutput, pixel, vec4(1.0));
        return;
    }

    vec3 centerPosition = ReconstructViewPosition(uv, centerDepth);
    vec3 normal = normalize(texture(viewNormalTexture, uv).xyz * 2.0 - 1.0);
    float noiseAngle = texture(blueNoiseTexture, uv * vec2(settings.screenAndQuality.xy) / 128.0).r * 6.2831853;
    mat2 rotation = mat2(cos(noiseAngle), -sin(noiseAngle), sin(noiseAngle), cos(noiseAngle));

    int directions = clamp(settings.screenAndQuality.z, 2, 16);
    int steps = clamp(settings.screenAndQuality.w, 2, 8);
    float occlusion = 0.0;
    float weightSum = 0.0;
    float radius = max(settings.radiusBiasIntensity.x, 0.001);
    float centerViewDistance = max(abs(centerPosition.z), 0.1);

    for (int d = 0; d < directions; ++d)
    {
        float angle = 6.2831853 * (float(d) + 0.5) / float(directions);
        vec2 direction = rotation * vec2(cos(angle), sin(angle));
        for (int s = 1; s <= steps; ++s)
        {
            float fraction = float(s) / float(steps);
            vec2 sampleUV = uv + direction * fraction * radius / centerViewDistance * 0.08;
            if (any(lessThan(sampleUV, vec2(0.0))) || any(greaterThan(sampleUV, vec2(1.0)))) continue;
            float sampleDepth = texture(deviceDepthTexture, sampleUV).r;
            vec3 samplePosition = ReconstructViewPosition(sampleUV, sampleDepth);
            vec3 delta = samplePosition - centerPosition;
            float distanceToSample = length(delta);
            float hemisphere = max(dot(normal, normalize(delta + vec3(1e-5))), 0.0);
            float rangeWeight = 1.0 - smoothstep(0.0, radius, distanceToSample);
            float blocked = step(settings.radiusBiasIntensity.y, samplePosition.z - centerPosition.z);
            float weight = blocked * hemisphere * rangeWeight;
            occlusion += weight;
            weightSum += 1.0;
        }
    }

    float ao = 1.0 - occlusion / max(weightSum, 1.0);
    ao = pow(clamp(ao, 0.0, 1.0), max(settings.radiusBiasIntensity.w, 0.1));
    ao = mix(1.0, ao, clamp(settings.radiusBiasIntensity.z, 0.0, 4.0));
    imageStore(aoOutput, pixel, vec4(clamp(ao, 0.0, 1.0)));
}
