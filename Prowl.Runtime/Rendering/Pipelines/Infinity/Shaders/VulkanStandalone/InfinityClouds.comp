#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D weatherMap;
layout(set = 0, binding = 1) uniform sampler3D shapeNoise;
layout(set = 0, binding = 2) uniform sampler3D detailNoise;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D cloudOutput;
layout(set = 0, binding = 4, std140) uniform CloudRenderSettings
{
    mat4 inverseViewProjection;
    vec4 cameraPosition;
    vec4 sunDirection;
    vec4 sunColor;
    vec4 cloudHeights; // base, top, max ray distance, density multiplier
    vec4 cloudControls; // coverage, wind x, wind z, phase g
    ivec4 dispatchAndQuality; // width, height, ray steps, light steps
} settings;

float CloudDensity(vec3 p, vec2 weather)
{
    vec3 q = p * 0.00035 + vec3(settings.cloudControls.y, 0.0, settings.cloudControls.z) * 0.0001;
    vec4 shape = texture(shapeNoise, fract(q * 2.0));
    vec4 detail = texture(detailNoise, fract(q * 7.0));
    float vertical = clamp((p.y - settings.cloudHeights.x) / max(settings.cloudHeights.y - settings.cloudHeights.x, 1.0), 0.0, 1.0);
    float profile = smoothstep(0.0, 0.10, vertical) * (1.0 - smoothstep(0.65, 1.0, vertical));
    float coverage = clamp(settings.cloudControls.x * weather.r, 0.0, 1.0);
    float threshold = mix(0.85, 0.28, coverage);
    float baseShape = shape.r * 0.65 + shape.b * 0.35;
    float carved = baseShape - detail.g * 0.22 - detail.a * 0.12;
    return clamp((carved - threshold) * settings.cloudHeights.w * 4.0, 0.0, 1.0) * profile;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloudOutput);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 farPoint = settings.inverseViewProjection * vec4(uv * 2.0 - 1.0, 0.0, 1.0);
    vec3 farWorld = farPoint.xyz / max(abs(farPoint.w), 1e-6);
    vec3 ray = normalize(farWorld - settings.cameraPosition.xyz);
    vec3 origin = settings.cameraPosition.xyz;

    float tEnter = 0.0;
    float tExit = settings.cloudHeights.z;
    if (abs(ray.y) > 1e-4)
    {
        float a = (settings.cloudHeights.x - origin.y) / ray.y;
        float b = (settings.cloudHeights.y - origin.y) / ray.y;
        tEnter = max(0.0, min(a, b));
        tExit = min(tExit, max(a, b));
    }
    if (tExit <= tEnter)
    {
        imageStore(cloudOutput, pixel, vec4(0.0));
        return;
    }

    vec2 weather = texture(weatherMap, fract(uv * 3.0 + settings.cloudControls.yz * 0.001)).rg;
    int steps = clamp(settings.dispatchAndQuality.z, 8, 96);
    float stepLength = (tExit - tEnter) / float(steps);
    float transmittance = 1.0;
    vec3 radiance = vec3(0.0);
    vec3 sunDir = normalize(settings.sunDirection.xyz);
    float phase = 0.35 + 0.65 * pow(max(dot(ray, sunDir), 0.0), 8.0);

    for (int i = 0; i < steps; ++i)
    {
        float t = tEnter + (float(i) + 0.5) * stepLength;
        vec3 p = origin + ray * t;
        float density = CloudDensity(p, weather);
        if (density > 0.001)
        {
            float extinction = density * stepLength * 0.0015;
            float absorbed = 1.0 - exp(-extinction);
            float powder = 1.0 - exp(-density * stepLength * 0.0025);
            radiance += transmittance * settings.sunColor.rgb * phase * powder;
            transmittance *= exp(-extinction);
            if (transmittance < 0.01) break;
        }
    }
    imageStore(cloudOutput, pixel, vec4(radiance, 1.0 - transmittance));
}
